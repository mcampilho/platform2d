include LICENSE pyproject.toml
include docs/using-platform2d.md
recursive-include platform2d *.py *.wav *.tmpl
recursive-include platform2d/locales *.json
recursive-include platform2d/fonts *.ttf *.otf *.txt *.json *.md
prune tests
prune examples
prune games
prune tutorials
prune artifacts
prune build
prune .venv
prune .release-env
prune .sdk-verify
prune .uv-cache
global-exclude __pycache__ *.py[cod]
