import argparse,os
from pathlib import Path

def main():
    parser=argparse.ArgumentParser()
    parser.add_argument('--headless',action='store_true'); parser.add_argument('--frames',type=int)
    parser.add_argument('--screenshot',type=Path)
    args=parser.parse_args()
    if args.headless: os.environ['SDL_VIDEODRIVER']=os.environ['SDL_AUDIODRIVER']='dummy'
    import pygame
    from platform2d.core.game import Game
    from platform2d.paths import user_data_dir
    from .scene import MyScene
    pygame.init()
    Game(MyScene(),{'left':['left','a'],'right':['right','d'],'jump':['space','z'],
         'restart':['r'],'pause':['p'],'reload_theme':['f7']},
         title=@TITLE@,size=(960,576),muted=args.headless,
         controls_path=user_data_dir('my-platform2d-game')/'controls.json').run(args.frames,args.screenshot)

if __name__=='__main__': main()
